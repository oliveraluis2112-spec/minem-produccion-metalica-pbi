{
  "name": "MINEM_Bento_Executive_Slate",
  "dataColors": [
    "#D97736",
    "#0F172A",
    "#334155",
    "#2563EB",
    "#059669",
    "#D97706",
    "#64748B",
    "#475569"
  ],
  "background": "#F8FAFC",
  "foreground": "#0F172A",
  "tableAccent": "#D97736",
  "visualStyles": {
    "*": {
      "*": {
        "outspacePane": [
          {
            "backgroundColor": { "solid": { "color": "#F8FAFC" } },
            "transparency": 0
          }
        ],
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#CBD5E1" } },
            "radius": 12
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": { "solid": { "color": "#0F172A" } },
            "transparency": 94,
            "preset": "Custom",
            "position": "SouthEast",
            "distance": 3,
            "blur": 6
          }
        ]
      }
    },
    "page": {
      "*": {
        "outspace": [
          {
            "color": { "solid": { "color": "#F8FAFC" } }
          }
        ]
      }
    }
  },
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 22,
      "color": "#0F172A"
    },
    "title": {
      "fontFace": "Segoe UI Bold",
      "fontSize": 14,
      "color": "#0F172A"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#0F172A"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#64748B"
    }
  }
}